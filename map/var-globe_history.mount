[Unit]
Description=Bind readsb globe_history where the host tar1090 expects it
Before=lighttpd.service
# NB: no After=local-fs.target. Local mount units are implicitly
# Before=local-fs.target, so adding After= creates an ordering cycle and systemd
# silently drops this mount at boot (replay then 404s with no error anywhere).
#
# Why this exists: the ultrafeeder container's readsb writes heatmap chunks to
# /var/globe_history *inside the container* = host /home/USER/ultrafeeder/globe_history.
# The host tar1090 serves /globe_history/ from the literal path
# /var/globe_history (alias regenerated by every tar1090 install), and lighttpd
# (www-data) usually can't traverse a 0750 home dir, so a symlink won't do.

[Mount]
What=/home/USER/ultrafeeder/globe_history
Where=/var/globe_history
Type=none
Options=bind,ro

[Install]
WantedBy=multi-user.target
